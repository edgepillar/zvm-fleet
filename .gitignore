.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# Build output.
bin/
*.exe
*.exe~
*.test

# A run's raw per-phase JSON is hundreds of megabytes; -out decides where it
# lands, and it belongs with the run.
results/

